# OUTLIERY Platform v2 — mẫu cấu hình. Chép thành .env rồi điền.
# Giai đoạn dev: để trống SESSION_SECRET cũng chạy (sinh tạm mỗi lần bật —
# restart là đăng nhập lại). Bản thay thế THẬT bắt buộc điền chuỗi ngẫu nhiên dài.
SESSION_SECRET=

# Đường users tạm P1 (mặc định data/nen/users.txt — tạo bằng
# python -m nen.gateway.tao_user_test). P2 nghỉ hưu, thay bằng iam.db.
# NEN_USERS=

# ---- NAS (nen/common/nas_sync.py, gọi từ gateway lúc đăng nhập/tự đổi mật khẩu) ----
# Mặc định TẮT — máy dev không bao giờ đụng tài khoản Windows; CHỈ bật trên máy
# server công ty (cần quyền SYSTEM/Admin để tạo user Windows).
NAS_DONG_BO=false
# Đường UNC các ổ NAS, ngăn bởi ';' (server có 2 share NAS1 + Video):
# NAS_DUONG_DAN=\\192.168.1.250\NAS1;\\192.168.1.250\Video
# Tên ổ (khớp tên share trong NAS_DUONG_DAN) CHỈ hiện với người đủ hành động
# nas_cap_cao (nen/rules/phan_quyen.json apps.to-chuc, mặc định level>=3):
# NAS_RIENG_MANAGER=NAS1
# Có giao diện web NAS (Synology/QNAP...) thì điền để trang /nas thêm nút mở:
# NAS_WEB=

# ---- Video Review ----
# Goc NAS chua ban dung; app LIEN KET toi file o day (khong chep, chi doc).
# Chua khai -> khoi them video an, trang bao Owner. Bom bien qua start-all.ps1.
# VR_NAS_DIR=F:\OutlierY Nas 2
# ffprobe de do codec video (H.265 phat ra tieng ma hinh den) — thieu thi app
# chi bo qua buoc do, khong canh bao bua:
# VR_FFPROBE=C:\OutlierY\tools\ffmpeg\bin\ffprobe.exe
