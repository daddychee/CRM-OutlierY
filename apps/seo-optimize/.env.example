# Copy sang .env (đã gitignore). KHÔNG commit key thật.
# CẢNH BÁO: file NÀY được git theo dõi (.gitignore có `!.env.example`). Dán key thật
# vào đây là commit luôn key — đã cắn 2026-07-30. Key thật CHỈ được nằm trong `.env`.

# ── LLM ── provider: anthropic | glm | (openai-compat)
LLM_PROVIDER=glm
# Key/model/base: dùng LLM_* HOẶC theo prefix provider (GLM_*, ANTHROPIC_*).
# GLM (z.ai) — reasoning model, code đã để max_tokens rộng:
GLM_API_KEY=<key z.ai của bạn>
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# hoặc Claude:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5
# hoặc OpenAI (đi qua nhánh openai-compat, không cần sửa code):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-5.1
# OPENAI_BASE_URL=https://api.openai.com/v1     ← mặc định, chỉ khai khi dùng endpoint khác

# ── Giá LLM (tùy chọn) ── USD cho 1 TRIỆU token, để board hiện tiền ước tính.
# Bỏ trống = chỉ hiện số token. Tra giá của model đang dùng rồi điền, KHÔNG đoán.
# Trần call LLM chạy CÙNG LÚC trên cả server (mặc định 8). Một người dùng một mình vẫn được
# trọn 4 dù đặt bao nhiêu — số này chỉ chặn lúc nhiều người bấm cùng lúc. Hay bị 429 thì hạ
# xuống 4; gói của bạn rộng rãi thì nâng lên.
# LLM_MAX_PARALLEL=8

LLM_PRICE_IN=
LLM_PRICE_OUT=

# ── YouTube Data API ── 1+ key, cách nhau dấu phẩy (xoay khi hết quota).
# (Hoặc mỗi dòng 1 key trong api.txt — cũng gitignore.)
YOUTUBE_API_KEYS=
# Nhiều key thì khai kiểu nào cũng được — tool gom hết rồi bỏ trùng:
#   YOUTUBE_API_KEYS=key1,key2,key3        (tất cả trên 1 dòng)
#   YOUTUBE_API_KEY_1=key1                 (mỗi key 1 dòng, đánh số 1..N)
#   YOUTUBE_API_KEY_2=key2
# Tên phải đúng mẫu YOUTUBE_API_KEY / _KEYS / _KEY_<số>; đặt kiểu KEY_BACKUP sẽ bị bỏ qua.

# (tùy chọn) transcript API cho SRT/kịch bản
# TRANSCRIPT_API_KEY=

# Cổng GUI web-local
PORT=8760

# ── CHIA SẺ CHO NGƯỜI KHÁC DÙNG (mặc định TẮT — chỉ máy này vào được) ──────────────
# Để trống cả hai dòng dưới = chạy một mình, không phải gõ mật khẩu, y như trước.
#
# BIND_HOST=0.0.0.0        ← mở ra mạng. BẮT BUỘC phải có BOARD_PASSWORD, không thì
#                             server TỪ CHỐI KHỞI ĐỘNG (cố ý, không phải lỗi).
# BOARD_PASSWORD=          ← mật khẩu CHUNG cho cả nhóm. Không phải tài khoản riêng
#                             từng người, không phân quyền, không ghi ai làm gì.
#
# VÌ SAO PHẢI CÓ: file .env này giữ key z.ai + toàn bộ key YouTube, và board có 6
# endpoint xoá dữ liệu. Ai vào được mạng cũng xoá được kênh/format/tập và tiêu hết
# quota của bạn.
#
# CHỈ DÙNG TRONG VPN NỘI BỘ (Tailscale) HOẶC LAN TIN CẬY. Mật khẩu này đi qua HTTP
# thường — phơi thẳng ra internet công cộng là nghe trộm được.
