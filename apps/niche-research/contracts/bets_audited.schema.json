{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "final_bets"
 ],
 "properties": {
  "rounds": {
   "type": "number"
  },
  "final_bets": {
   "type": "array",
   "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
     "topic",
     "verdict"
    ],
    "properties": {
     "topic": {
      "type": "string"
     },
     "verdict": {
      "enum": [
       "CLONE NOW",
       "CLONE",
       "TEST",
       "SKIP"
      ]
     },
     "angle": {
      "type": "string"
     },
     "provenance": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "falsifier": {
      "type": "string"
     }
    }
   }
  },
  "disagreements": {
   "type": "array",
   "items": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
     "topic",
     "label"
    ],
    "properties": {
     "topic": {
      "type": "string"
     },
     "label": {
      "enum": [
       "REFUTE",
       "UNCERTAIN"
      ]
     },
     "reason": {
      "type": "string"
     }
    }
   }
  }
 }
}