{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "category",
  "rpm_band_usd",
  "verdict",
  "score"
 ],
 "properties": {
  "category": {
   "type": "string"
  },
  "rpm_band_usd": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "rpm_label": {
   "enum": [
    "HIGH",
    "MEDIUM",
    "LOW"
   ]
  },
  "sponsor_density": {
   "type": "number"
  },
  "verdict": {
   "enum": [
    "HIGH",
    "MEDIUM",
    "LOW"
   ]
  },
  "score": {
   "type": "number"
  }
 }
}