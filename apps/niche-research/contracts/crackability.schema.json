{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "verdict",
  "newcomer_rate",
  "score"
 ],
 "properties": {
  "verdict": {
   "enum": [
    "OPEN",
    "SEMI",
    "CLOSED",
    "UNKNOWN"
   ]
  },
  "newcomer_rate": {
   "type": "number"
  },
  "authority_dependence": {
   "type": [
    "number",
    "null"
   ]
  },
  "pattern_replicability": {
   "type": "number"
  },
  "score": {
   "type": [
    "number",
    "null"
   ]
  },
  "reason": {
   "type": "string"
  }
 }
}