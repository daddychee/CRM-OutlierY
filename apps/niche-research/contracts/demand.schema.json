{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "demand_median_views",
  "trend",
  "score"
 ],
 "properties": {
  "demand_median_views": {
   "type": "number"
  },
  "reach_p90_views": {
   "type": "number"
  },
  "supply_per_month": {
   "type": "number"
  },
  "trend": {
   "enum": [
    "RISING",
    "FLAT",
    "DECLINING"
   ]
  },
  "trend_strength": {
   "type": "number"
  },
  "score": {
   "type": "number"
  }
 }
}