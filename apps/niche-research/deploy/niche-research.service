# systemd unit cho Niche Research
# Copy vào: /etc/systemd/system/niche-research.service
# Rồi:      sudo systemctl daemon-reload && sudo systemctl enable --now niche-research

[Unit]
Description=Niche Research Web Server (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=nichers
WorkingDirectory=/opt/niche-research
ExecStart=/opt/niche-research/.venv/bin/python server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=NICHE_HOST=127.0.0.1
Environment=NICHE_PORT=8780
# .env (LLM key + TRANSCRIPT_API_KEY) nằm cùng thư mục, server.py đọc qua _common.get_env()

[Install]
WantedBy=multi-user.target
