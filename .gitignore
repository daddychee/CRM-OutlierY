# Bi mat & moi truong — khong bao gio vao git
.env
.env.*
!.env.example
*API*.txt
*api key*
users.txt

# DU LIEU VAN HANH — tai san, backup lo (khong phai git)
data/
logs/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Rac AppleDouble/macOS (bai hoc 31/07 git add -A quet ca tram file ._*)
._*
.DS_Store

# Binary cong cu — chep bang script, khong vao git
tools/qdrant/qdrant.exe
tools/caddy/caddy.exe
*.snapshot

# Editor
.vscode/
.qdrant-initialized

# Du lieu mau la bao cao THAT cua cong ty - o dia cho test, khong vao git
apps/*/tests/du-lieu-mau/

# Repo tham khao (clone ngoai, khong commit)
_references/

# App co REPO GIT RIENG (tach 19/08 — cap quyen collaborator GitHub theo TUNG app,
# nhan su chi duoc dung repo app minh): nguon su that la repo con nam ngay trong
# apps/<slug>/.git; repo cha (nen) khong track code app nay nua. Cac app khac se
# tach dan sau khi mach phien song song tren monorepo lang xuong.
apps/seo-optimize/

# Cookie phien lay tu trinh duyet (Google Trends) — BI MAT, khong bao gio vao git
trends_cookies.json
*_cookies.json
cookies.txt

# Ket qua cao/xuat tam — tai san chay lai duoc, khong phai ma nguon
downloads/

# File trung gian cua mot lan phan tich (tien to _ = nhap, khong ai tham chieu)
docs/_*.json

# Editor workspace
*.code-workspace

# 4 app CO REPO GIT RIENG (tach 24/08 — cung khuon seo-optimize 19/08): moi app
# mot repo private, nhanh `v3` la ban dang chay, `main` giu lich su V2 lam su
# lieu. Nguon su that la repo con nam ngay trong apps/<slug>/.git; repo cha
# (nen) khong track code 4 app nay nua. File VAN NAM NGUYEN CHO CU tren dia nen
# duong dan/tien trinh/test goc khong doi mot ly.
apps/radary/
